# Professor.Claude.AI environment variables
# Copy this to .env and fill in values. NEVER commit .env.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Optional but recommended ---
# LangSmith for tracing/observability (free tier available)
LANGSMITH_API_KEY=lsv2_pt_xxxxx
LANGSMITH_PROJECT=professor-claude-ai
LANGSMITH_TRACING=true

# --- Email digest delivery (v0.1) ---
# Use any SMTP provider. Gmail app passwords work fine.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password
DIGEST_RECIPIENT=your.email@gmail.com

# --- Local triage model (v0.2+, deferred pending Manning SLM book) ---
# OLLAMA_HOST=http://localhost:11434
# TRIAGE_MODEL=gemma2:9b

# --- Runtime config ---
# Path where the SQLite checkpointer database lives (LangGraph short-term memory)
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# Path where the ChromaDB vector store lives (semantic memory)
CHROMA_PERSIST_DIR=./data/chroma
# Path where the DuckDB episodic log lives
EPISODIC_DB_PATH=./data/episodic.duckdb
# Cap on deep-reads per nightly run (anti-overload mechanism)
MAX_DEEP_READS_PER_RUN=2
# Subfield keywords for v0.1 (agents and harnesses)
SUBFIELD_KEYWORDS=agent,agentic,harness,tool-use,tool use,scaffold,react,llm-agent
